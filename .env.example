# Optional; Prozess-ENV hat Vorrang, explizite CLI-Optionen danach.
# Native Starts lesen .env aus dem aktuellen Arbeitsverzeichnis.
WORLD_NAME=alpha
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=
# Nur NEUE Welt; vorhandene Karten werden nicht verändert. Felder, nicht Pixel.
# Breite/Höhe ganze Zahlen 2..64; NPCs 0..4095 und genug freie Landfelder.
WORLD_WIDTH=24
WORLD_HEIGHT=24
WORLD_NPC_COUNT=18
# Ab Neustart; Nahrung pro Einheit/STUNDE, 0..3600000; Punkt als Dezimalzeichen.
UPKEEP_INFANTRY_PER_HOUR=360
UPKEEP_SCOUT_PER_HOUR=180
# Optionales milderes Balancebeispiel (keine Fehlerkorrektur):
# UPKEEP_INFANTRY_PER_HOUR=36
# UPKEEP_SCOUT_PER_HOUR=18
# Sekunden 0.001..31536000; neue Mangelzyklen ab Neustart.
SUPPLY_GRACE_SECONDS=1800
SUPPLY_LOSS_INTERVAL_SECONDS=300
# Prozent 0.000001..100
SUPPLY_LOSS_PERCENT=5
SUPPLY_RECOVERY_SECONDS=60

# Auftrag 12: vorläufige Regeln ab Neustart, nur neue Angebote/Aufträge.
# Gespeicherte Bewerber bleiben bis zum Wechsel erhalten; kein Client-Rebuild.
GENERAL_MAX_COUNT=3 # Ganzzahl 1–100; vorhandene Generäle bleiben bei Senkung
GENERAL_RECRUIT_WOOD=500 # Basis-Holzpreis, Ganzzahl 1–1000000
GENERAL_RECRUIT_STONE=500 # Basis-Steinpreis, Ganzzahl 1–1000000
GENERAL_RECRUIT_COST_EXPONENT=2 # Ganzzahl 1–3; Basis × Erwerbszähler^Exponent
GENERAL_CANDIDATE_REFRESH_HOURS=24 # Stunden, 1/60–8760, einmal auf ms gerundet
RESEARCH_LEADERSHIP_PERCENT=1 # Prozent/Führungspunkt, 0–10
RESEARCH_BONUS_CAP_PERCENT=50 # Prozent Geschwindigkeit, 0–100
