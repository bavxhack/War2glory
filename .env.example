# Optional; Prozess-ENV hat Vorrang, explizite CLI-Optionen danach.
# Native Starts lesen .env aus dem aktuellen Arbeitsverzeichnis.
WORLD_NAME=alpha
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=
# Nur NEUE Welt; vorhandene Karten werden nicht verändert. Felder, nicht Pixel.
# Breite/Höhe ganze Zahlen 2..64; NPCs 0..4095 und genug freie Landfelder.
WORLD_WIDTH=24
WORLD_HEIGHT=24
WORLD_NPC_COUNT=18
# Ab Neustart; Nahrung pro Einheit/STUNDE, 0..3600000; Punkt als Dezimalzeichen.
UPKEEP_INFANTRY_PER_HOUR=360
UPKEEP_SCOUT_PER_HOUR=180
# Optionales milderes Balancebeispiel (keine Fehlerkorrektur):
# UPKEEP_INFANTRY_PER_HOUR=36
# UPKEEP_SCOUT_PER_HOUR=18
# Sekunden 0.001..31536000; neue Mangelzyklen ab Neustart.
SUPPLY_GRACE_SECONDS=1800
SUPPLY_LOSS_INTERVAL_SECONDS=300
# Prozent 0.000001..100
SUPPLY_LOSS_PERCENT=5
SUPPLY_RECOVERY_SECONDS=60
